/** @jlc-page
 * title: 首页
 * summary: 应用管理器：全部 .jlc 应用以卡片呈现，点击即用内核挂载（同名 0.5 应用覆盖 0.4）
 * policy: trusted
 * isolation: soft
 * fault: degrade
 * capabilities:
 * demo: 目录来自 jlc://meta/apps（宿主实时解析每个 .jlc 的 @jlc-page 元数据）
 */
app Home {
  resource catalog = http("jlc://meta/apps");
  resource version = http("jlc://meta/version");

  derive apps = catalog.data == null ? [] : catalog.data.apps;
  derive count = len(apps);
  derive kernelLine = version.data == null ? "" : "内核 " + version.data.kernel + " · 宿主 " + version.data.host;

  action openApp(name) {
    navigate("#/" + name + ".jlc");
    return null;
  }

  style `
    .home { display: grid; gap: 14px; }
    .home-head { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
    .home-head h1 { margin: 0; font: 800 22px/1.3 var(--display); }
    .home-grid {
      display: grid; gap: 12px;
      grid-template-columns: repeat(auto-fill, minmax(215px, 1fr));
    }
    .home-card {
      display: grid; gap: 8px;
      padding: 14px;
      background: var(--surface);
      border: 1.5px solid var(--border);
      border-radius: 14px;
      cursor: pointer;
      transition: transform 130ms ease, border-color 130ms ease, box-shadow 130ms ease;
    }
    .home-card:hover {
      transform: translateY(-3px);
      border-color: var(--md-sys-color-primary);
      box-shadow: var(--md-shadow-sm);
    }
    .home-top { display: flex; align-items: center; gap: 9px; }
    .home-ico {
      display: grid; place-items: center;
      width: 38px; height: 38px; flex: none;
      font-size: 19px; border-radius: 11px;
      background: var(--field); border: 1px solid var(--md-divider);
    }
    .home-name { font: 700 14.5px/1.3 var(--display); min-width: 0; overflow: hidden; text-overflow: ellipsis; }
    .home-summary {
      margin: 0; color: var(--muted); font-size: 12px; line-height: 1.55;
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
      min-height: 37px;
    }
    .home-tags { display: flex; gap: 5px; flex-wrap: wrap; }
    .home-tag {
      font: 600 10px/1 var(--mono);
      padding: 3.5px 7px; border-radius: 6px;
      background: var(--acc-4); color: var(--muted);
      border: 1px solid var(--md-divider);
    }
    .home-tag-sys { background: var(--md-sys-color-primary-container); color: var(--md-sys-color-on-primary-container); border-color: transparent; }
    .home-foot { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: 2px; }
  `;

  view {
    main(class = "home") {
      div(class = "home-head") {
        h1 { text "应用"; }
        span(class = "muted") { text count + " 个 .jlc · 全部跑在本机 VM"; }
      }
      when (catalog.loading) {
        p(class = "muted") { text "正在读取应用目录…"; }
      }
      when (catalog.error != null) {
        p(class = "muted") { text "目录加载失败：" + catalog.error.message; }
      }
      div(class = "home-grid") {
        each (app in apps key app.name) {
          div(class = "home-card", on:click = { openApp(app.name); }, role = "button") {
            div(class = "home-top") {
              span(class = "home-ico") { text app.icon; }
              span(class = "home-name") { text app.title; }
            }
            p(class = "home-summary") { text app.summary; }
            div(class = "home-tags") {
              span(class = "home-tag" + (app.origin == "system" ? " home-tag-sys" : "")) {
                text app.origin == "system" ? "系统" : "0.4";
              }
              span(class = "home-tag") { text app.policy; }
              each (cap in app.capabilities) {
                span(class = "home-tag") { text cap; }
              }
            }
            div(class = "home-foot") {
              span(class = "muted") { text app.name + ".jlc"; }
              span(class = "muted") { text app.bytes + " B"; }
            }
          }
        }
      }
      when (kernelLine != "") {
        p(class = "muted") { text kernelLine; }
      }
    }
  }
}
