/** @jlc-page
 * title: 待办清单
 * summary: 0.5 增强版：每次增删改都写进本机 IndexedDB（jlc://storage/todo/items），刷新不丢
 * policy: strict
 * isolation: soft
 * capabilities: storage
 * storage: items
 * demo: 装载时宿主把已存状态经 mount({ state }) 注入；变更时 storagePut 落盘。strict 档 + 显式 capability
 */
app TodoPro {
  state draft = "";
  state items = [
    { id: 1, text: "读 SPEC.md", done: true },
    { id: 2, text: "体验 0.5 的本地持久化", done: false }
  ];
  state done = 1;
  state nextId = 3;
  state savedAt = 0;

  derive left = len(items) - done;
  derive heading = "待办 " + left + " / " + len(items) + " 项";
  derive savedNote = savedAt == 0 ? "还没保存过（首次编辑后自动落盘）" : "已保存到本机 IndexedDB（" + string(savedAt) + "）";

  action persist() {
    storagePut("items", items);
    savedAt = now();
    return null;
  }

  action add() {
    let text = trim(draft);
    if (text == "") { return null; }
    items = append(items, { id: nextId, text: text, done: false });
    nextId += 1;
    draft = "";
    persist();
    return null;
  }

  action toggle(id) {
    let next = [];
    let count = 0;
    for (item, index in items) {
      let flag = item.id == id ? !item.done : item.done;
      if (flag) { count += 1; }
      next = append(next, { id: item.id, text: item.text, done: flag });
    }
    items = next;
    done = count;
    persist();
    return null;
  }

  action remove(id) {
    let next = [];
    let count = done;
    for (item, index in items) {
      if (item.id != id) {
        next = append(next, item);
      } else if (item.done) {
        count -= 1;
      }
    }
    items = next;
    done = count;
    persist();
    return null;
  }

  style `
    .todo { display: grid; gap: 12px; }
    .todo h2 { margin: 0; font: 800 20px/1.3 var(--display); }
    .todo-add { display: flex; gap: 8px; }
    .todo-add input { flex: 1; padding: 9px 11px; border: 2px solid var(--border); background: var(--field); color: var(--ink); font: inherit; border-radius: 10px; }
    .todo-list { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; }
    .todo-row { display: flex; align-items: center; gap: 10px; padding: 9px 11px; border: 2px solid var(--border); background: var(--surface); border-radius: 11px; }
    .todo-row span { flex: 1; }
    .done { opacity: .45; }
    .done span { text-decoration: line-through; }
    .todo-save { display: flex; align-items: center; gap: 8px; }
  `;

  view {
    main(class = "todo") {
      h2 { text heading; }
      form(class = "todo-add", on:submit.prevent = { add(); }) {
        input(placeholder = "再添一件事…", bind:value = draft, aria:label = "新待办");
        button(type = "submit") { text "加入"; }
      }
      ul(class = "todo-list") {
        each (item, index in items key item.id) {
          li(class = "todo-row", class:done = item.done) {
            input(type = "checkbox", checked = item.done, on:change = { toggle(item.id); }, aria:label = "完成");
            span { text item.text; }
            button(on:click = { remove(item.id); }, aria:label = "删除") { text "×"; }
          }
        } else {
          li(class = "empty") { text "全部完成 🎉"; }
        }
      }
      p(class = "muted") { text "剩余 " + left + " 项 · 列表长度 " + len(items); }
      div(class = "todo-save") {
        span(class = "badge") { text "💾 本地持久化"; }
        span(class = "muted") { text savedNote; }
      }
    }
  }
}
