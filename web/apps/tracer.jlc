/** @jlc-page
 * title: 响应式追踪器
 * summary: 定时器 / emit / 窗口事件委托 / capability 计数——把 runtime.ledger() 的数字变成会动的东西
 * policy: open
 * isolation: strict
 * capabilities: storage
 * demo: 起停定时器看 cycles/effects 变化；「广播」用 emit 在根元素上自顶向下捕获；把 fault 切到 report 再看窗口事件被拒时的行为差异
 */
app SignalTracer {
  state ticks = 0;
  state running = false;
  state trace = [];
  state saved = 0;
  state resizes = 0;

  derive label = running ? "运行中" : "已暂停";
  derive rate = ticks * 3;
  derive lastEvent = len(trace) == 0 ? "—" : at(trace, len(trace) - 1);

  action start() {
    if (running) { return null; }
    running = true;
    every (333) { tick(); }
    return null;
  }

  action stop() {
    running = false;
    return null;
  }

  action tick() {
    if (running == false) { return null; }
    ticks += 1;
    if (ticks % 4 == 0) { persist(); }
    return null;
  }

  action broadcast(kind) {
    emit("trace", { kind: kind + " @" + ticks, ticks: ticks });
    return null;
  }

  action persist() {
    saved = storage("increment", "jlc-tracer", 1);
    return null;
  }

  style `
    .tracer { display: grid; gap: 14px; }
    .tracer-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 10px; }
    .tracer-metric { border: 2px solid var(--border); background: var(--surface); padding: 10px 12px; }
    .tracer-metric strong { display: block; font: 700 30px / 1 var(--display); }
    .tracer-metric span { font: 500 11px ui-monospace, monospace; color: var(--muted); }
    .tracer-bar { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
    .tracer-trace { display: flex; gap: 6px; flex-wrap: wrap; }
    .tracer-trace span { padding: 4px 8px; border: 2px solid var(--border); background: var(--field); font: 600 11.5px ui-monospace, monospace; }
  `;

  action note(kind) {
    trace = append(trace, kind);
    if (len(trace) > 8) { trace = removeAt(trace, 0); }
    return null;
  }

  view {
    main(class = "tracer", on:trace = { note("捕获 " + $event.detail.kind); }) {
      div(class = "tracer-bar") {
        strong { text "调度与副作用"; }
        span(class = "badge") { text label; }
        when (running) { span(class = "badge badge--go") { text "every 333ms"; } }
        button(on:click = { start(); }) { text "启动"; }
        button(on:click = { stop(); }) { text "暂停"; }
        button(on:click = { broadcast("emit"); }) { text "广播一次"; }
        button(on:click = { persist(); }) { text "写一次 storage"; }
      }
      div(class = "tracer-grid") {
        div(class = "tracer-metric") { strong { text ticks; } span { text "ticks"; } }
        div(class = "tracer-metric") { strong { text rate; } span { text "ticks × 3（derive）"; } }
        div(class = "tracer-metric") { strong { text saved; } span { text "storage 计数"; } }
        div(class = "tracer-metric") { strong { text resizes; } span { text "窗口 resize"; } }
      }
      div(class = "tracer-trace") {
        each (entry, index in trace) {
          span { text entry; }
        } else {
          span(class = "muted") { text "还没有事件"; }
        }
      }
      div(on:resize.window = { resizes += 1; }, class = "muted") {
        text "这个节点把 resize 委托到了 window（需要 allowWindowEvents）：" + lastEvent;
      }
      p(class = "muted") { text "暂停后 every 仍在跑，但 tick() 会立刻返回——把内核 ledger 的 cycles 涨速和 ticks 解耦，是策略层想要的效果。"; }
    }
  }
}
