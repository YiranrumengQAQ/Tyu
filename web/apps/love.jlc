/**
 * @jlc-page
 * name: romance
 * policy: open
 * isolation: strict
 * fault: degrade
 */

app RomanceStudio {

  state booting = true;
  state themeName = "晨光";
  state fontSize = 1;

  state quotes = [
    { id: 1,  text: "你是我藏在心里的春天，每次想起，都会开花。", author: "佚名", category: "心动" },
    { id: 2,  text: "世间所有的相遇，都是久别重逢。", author: "白落梅", category: "相遇" },
    { id: 3,  text: "我想和你一起，看日出日落，看细水长流。", author: "佚名", category: "陪伴" },
    { id: 4,  text: "你不用完美，你只要是你，就足够让我心动。", author: "佚名", category: "心动" },
    { id: 5,  text: "我把星星摘下来给你，你说不如我眼里的光。", author: "佚名", category: "心动" },
    { id: 6,  text: "风起了，我在想你；风停了，我还在想你。", author: "佚名", category: "思念" },
    { id: 7,  text: "遇见你之后，我才知道，原来日子可以这么甜。", author: "佚名", category: "相遇" },
    { id: 8,  text: "我想要的很简单，时光还在，你还在。", author: "佚名", category: "陪伴" },
    { id: 9,  text: "你笑起来的样子，是我见过最好的风景。", author: "佚名", category: "心动" },
    { id: 10, text: "如果思念有声音，你一定会被吵醒。", author: "佚名", category: "思念" },
    { id: 11, text: "愿我如星君如月，夜夜流光相皎洁。", author: "范成大", category: "思念" },
    { id: 12, text: "山有木兮木有枝，心悦君兮君不知。", author: "越人歌", category: "思念" },
    { id: 13, text: "往后余生，风雪是你，平淡是你，清贫也是你。", author: "佚名", category: "陪伴" },
    { id: 14, text: "愿所有的后会有期，都是他日的别来无恙。", author: "佚名", category: "陪伴" },
    { id: 15, text: "我们绕了这么一圈才遇到，我比谁都更明白你的重要。", author: "佚名", category: "相遇" }
  ];

  state themes = [
    { id: "晨光", accent: "#ff8fab", bg: "#efe7f6", light: "#ffffff", dark: "#e0d3ee", inset: "#f4ecfa", ink: "#2c2438", ink2: "#4a3f5c", muted: "#8d80a3", darkMode: false },
    { id: "夜色", accent: "#b8a4ff", bg: "#1a1622", light: "#332b42", dark: "#17121f", inset: "#1e1929", ink: "#f3eefb", ink2: "#cfc4e2", muted: "#938aa8", darkMode: true },
    { id: "樱花", accent: "#ff5c8a", bg: "#fff0f4", light: "#ffffff", dark: "#fce2ea", inset: "#fff5f8", ink: "#3a1f2b", ink2: "#5c3a48", muted: "#a17f8c", darkMode: false },
    { id: "海盐", accent: "#3bb8a6", bg: "#e6f5f2", light: "#ffffff", dark: "#d2ece6", inset: "#eefaf7", ink: "#193230", ink2: "#2f504c", muted: "#6a9290", darkMode: false },
    { id: "星河", accent: "#7aa7f0", bg: "#eaf0fd", light: "#ffffff", dark: "#d8e2f8", inset: "#f2f6fd", ink: "#1e2a4a", ink2: "#3a4a6b", muted: "#7183a8", darkMode: false }
  ];

  state petals = [
    { id: 1, left: 6,  size: 16, duration: 22, delay: -2 },
    { id: 2, left: 24, size: 20, duration: 27, delay: -9 },
    { id: 3, left: 45, size: 14, duration: 19, delay: -14 },
    { id: 4, left: 68, size: 22, duration: 29, delay: -5 },
    { id: 5, left: 88, size: 15, duration: 24, delay: -18 }
  ];

  state currentIndex = 0;
  state activeCategory = "全部";
  state favorites = [];
  state typedChars = 0;
  state typing = false;
  state typingToken = 0;
  state toast = "";
  state toastKind = "info";
  state visited = 1;

  derive categories = ["全部", "心动", "相遇", "陪伴", "思念"];
  derive currentTheme = getTheme(themes, themeName);
  derive accent = get(currentTheme, "accent", "#ff8fab");
  derive isDark = get(currentTheme, "darkMode", false);

  derive currentQuote = get(quotes, currentIndex, {
    id: 0,
    text: "点击下方按钮，遇见一句温柔的话。",
    author: "心语笺",
    category: "全部"
  });

  derive total = max(1, len(currentQuote.text));
  derive displayText = slice(currentQuote.text, 0, typedChars);
  derive progress = clamp(round(typedChars * 100 / total), 0, 100);
  derive isFav = checkFav(favorites, currentQuote.id);
  derive favCount = len(favorites);
  derive quoteNumber = currentIndex + 1;
  derive quoteTotal = len(quotes);
  derive scaledSize = fontSize == 1 ? "1.8rem" : (fontSize == 2 ? "2.2rem" : "2.6rem");
  derive scrollProgress = clamp(round($scroll.y / 5), 0, 100);

  style `
    *, *::before, *::after { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; min-height: 100dvh; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: var(--bg);
      color: var(--ink);
      line-height: 1.7;
      transition: background-color .4s ease, color .4s ease;
      overflow-x: hidden;
    }
    .page {
      max-width: 860px;
      margin: 0 auto;
      padding: 24px 16px 80px;
      display: flex;
      flex-direction: column;
      gap: 20px;
      position: relative;
      z-index: 1;
    }
    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 20px;
      border-radius: 24px;
      background: var(--light);
      box-shadow: 6px 6px 16px rgba(0,0,0,.06), -4px -4px 12px rgba(255,255,255,.8);
      position: relative;
      overflow: hidden;
    }
    .topbar-progress {
      position: absolute;
      left: 0;
      bottom: 0;
      height: 3px;
      background: var(--accent);
      transition: width .1s linear;
    }
    .brand-title { margin: 0; font-size: 1.25rem; font-weight: 700; }
    .brand-sub { margin: 0; font-size: .75rem; color: var(--muted); }
    .stage {
      padding: 40px 32px 30px;
      border-radius: 32px;
      background: var(--light);
      box-shadow: 10px 10px 24px rgba(0,0,0,.06), -6px -6px 16px rgba(255,255,255,.9);
    }
    .quote-line {
      margin: 0;
      font-weight: 600;
      line-height: 1.6;
      cursor: pointer;
      min-height: 2.2em;
    }
    .caret {
      display: inline-block;
      width: 3px;
      height: 1em;
      margin-left: 4px;
      background: var(--accent);
      animation: blink 1s steps(2,start) infinite;
    }
    @keyframes blink { 50% { opacity: 0; } }
    .quote-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 24px;
      padding-top: 16px;
      border-top: 1px dashed var(--muted);
      font-size: .85rem;
      color: var(--muted);
    }
    .actions {
      display: flex;
      justify-content: center;
      gap: 12px;
      flex-wrap: wrap;
      padding: 16px;
      border-radius: 24px;
      background: var(--light);
      box-shadow: 6px 6px 16px rgba(0,0,0,.05);
    }
    .btn {
      padding: 11px 20px;
      font-size: .82rem;
      font-weight: 700;
      border: none;
      border-radius: 999px;
      cursor: pointer;
      background: var(--inset);
      color: var(--ink);
      transition: transform .15s ease;
    }
    .btn:hover { transform: translateY(-2px); }
    .btn--accent { background: var(--accent); color: #fff; }
    .filters { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; }
    .pill {
      padding: 7px 16px;
      font-size: .78rem;
      border-radius: 999px;
      border: none;
      background: var(--light);
      cursor: pointer;
      color: var(--muted);
    }
    .pill--on { background: var(--accent); color: #fff; font-weight: 700; }
    .fav-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .fav-item {
      padding: 14px 18px;
      border-radius: 18px;
      background: var(--inset);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .toast {
      position: fixed;
      left: 50%;
      bottom: 30px;
      transform: translateX(-50%);
      padding: 12px 24px;
      border-radius: 999px;
      background: var(--ink);
      color: var(--light);
      font-size: .85rem;
      font-weight: 700;
      z-index: 100;
    }
  `;

  style ":root{" +
    "--accent:" + get(currentTheme, "accent", "#ff8fab") + ";" +
    "--bg:" + get(currentTheme, "bg", "#efe7f6") + ";" +
    "--light:" + get(currentTheme, "light", "#ffffff") + ";" +
    "--dark:" + get(currentTheme, "dark", "#e0d3ee") + ";" +
    "--inset:" + get(currentTheme, "inset", "#f4ecfa") + ";" +
    "--ink:" + get(currentTheme, "ink", "#2c2438") + ";" +
    "--muted:" + get(currentTheme, "muted", "#8d80a3") + ";" +
    "}";

  action getTheme(list, name) {
    for (t in list) {
      if (t.id == name) {
        return t;
      }
    }
    return { id: "晨光", accent: "#ff8fab", bg: "#efe7f6", light: "#ffffff", dark: "#e0d3ee", inset: "#f4ecfa", ink: "#2c2438", muted: "#8d80a3", darkMode: false };
  }

  action checkFav(list, id) {
    for (item in list) {
      if (item.id == id) {
        return true;
      }
    }
    return false;
  }

  action notify(msg) {
    toast = msg;
    after (2000) {
      if (toast == msg) {
        toast = "";
      }
    }
  }

  action setTheme(name) {
    themeName = name;
    let t = getTheme(themes, name);
    title("心语笺 · " + name);
    favicon("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><circle cx='16' cy='16' r='14' fill='" + t.accent + "'/></svg>");
    notify("已切换主题：" + name);
  }

  action setCategory(cat) {
    activeCategory = cat;
    let count = len(quotes);
    for (i in range(0, count)) {
      let q = get(quotes, i);
      if (q != null) {
        if (cat == "全部" || q.category == cat) {
          currentIndex = i;
          startTyping();
          notify("心境：" + cat);
          return;
        }
      }
    }
  }

  action step(dir) {
    let count = len(quotes);
    for (i in range(0, count)) {
      let idx = (currentIndex + dir * (i + 1) + count * 32) % count;
      let q = get(quotes, idx);
      if (q != null) {
        if (activeCategory == "全部" || q.category == activeCategory) {
          currentIndex = idx;
          visited += 1;
          startTyping();
          return;
        }
      }
    }
  }

  action shuffle() {
    let count = len(quotes);
    let target = (now() + visited) % count;
    currentIndex = target;
    visited += 1;
    startTyping();
    notify("心选已更新");
  }

  action startTyping() {
    typingToken += 1;
    let token = typingToken;
    typedChars = 0;
    typing = true;
    title("心语笺 · " + currentQuote.category + " · " + currentQuote.author);
    tick(token);
  }

  action tick(token) {
    if (token != typingToken) {
      return;
    }
    if (typedChars < len(currentQuote.text)) {
      typedChars += 1;
      after (32) {
        tick(token);
      }
    } else {
      typing = false;
    }
  }

  action finishTyping() {
    typingToken += 1;
    typedChars = len(currentQuote.text);
    typing = false;
  }

  action toggleFav() {
    if (checkFav(favorites, currentQuote.id)) {
      let next = [];
      for (f in favorites) {
        if (f.id != currentQuote.id) {
          next = append(next, f);
        }
      }
      favorites = next;
      notify("已移出心选");
    } else {
      favorites = append(favorites, currentQuote);
      notify("已收入心选");
    }
  }

  action jumpFav(id) {
    let count = len(quotes);
    for (i in range(0, count)) {
      let q = get(quotes, i);
      if (q.id == id) {
        currentIndex = i;
        startTyping();
        return;
      }
    }
  }

  view {
    div(class = "page") {

      header(class = "topbar") {
        div(class = "topbar-progress", style:width = scrollProgress + "%");
        div {
          h1(class = "brand-title") { text "心语笺"; }
          p(class = "brand-sub") { text "纸短情长 · 一字一句"; }
        }
        div {
          each (t in themes key t.id) {
            button(
              class = "pill" + (themeName == t.id ? " pill--on" : ""),
              on:click = { setTheme(t.id); }
            ) {
              text t.id;
            }
          }
        }
      }

      section(class = "stage") {
        div {
          p(
            class = "quote-line",
            style:fontSize = scaledSize,
            on:click = { finishTyping(); },
            title = "点击显示全文"
          ) {
            text displayText;
            when (typing) {
              span(class = "caret");
            }
          }
          div(class = "quote-meta") {
            span { text "—— " + currentQuote.author; }
            span { text currentQuote.category; }
            span { text string(quoteNumber) + " / " + string(quoteTotal); }
          }
        }
      }

      section(class = "actions") {
        button(class = "btn", on:click = { step(-1); }) { text "上一句"; }
        button(class = "btn btn--accent", on:click = { shuffle(); }) { text "换一句"; }
        button(class = "btn", on:click = { toggleFav(); }) {
          when (isFav) {
            text "已收藏";
          } else {
            text "收藏";
          }
        }
        button(class = "btn", on:click = { step(1); }) { text "下一句"; }
      }

      nav(class = "filters") {
        each (cat in categories key cat) {
          button(
            class = "pill" + (activeCategory == cat ? " pill--on" : ""),
            on:click = { setCategory(cat); }
          ) {
            text cat;
          }
        }
      }

      when (favCount > 0) {
        section {
          h3 { text "心选收藏 (" + string(favCount) + ")"; }
          ul(class = "fav-list") {
            each (item in favorites key item.id) {
              li(class = "fav-item") {
                span { text item.text; }
                button(class = "btn", on:click = { jumpFav(item.id); }) { text "查看"; }
              }
            }
          }
        }
      }

      when (toast != "") {
        div(class = "toast") { text toast; }
      }
    }
  }
}
