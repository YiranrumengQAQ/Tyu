{
  "name": "@tyu/jlc-kernel",
  "version": "0.4.0",
  "description": "JLC: a dependency-free bytecode virtual machine and compiler for browser interfaces",
  "type": "module",
  "main": "./jlc.js",
  "module": "./jlc.js",
  "types": "./jlc.d.ts",
  "exports": {
    ".": {
      "types": "./jlc.d.ts",
      "import": "./jlc.js",
      "default": "./jlc.js"
    },
    "./vm": {
      "types": "./jlc.d.ts",
      "import": "./jlc-vm.js",
      "default": "./jlc-vm.js"
    },
    "./compiler": {
      "types": "./jlc.d.ts",
      "import": "./jlc-compiler.js",
      "default": "./jlc-compiler.js"
    }
  },
  "files": [
    "jlc.js",
    "jlc-vm.js",
    "jlc-compiler.js",
    "jlc.d.ts",
    "README.md",
    "SPEC.md",
    "JBC.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test",
    "build:web": "node scripts/build-web.mjs",
    "check:web": "node scripts/build-web.mjs --check",
    "serve": "node scripts/serve-web.mjs",
    "check": "node --check jlc.js && node --check jlc-vm.js && node --check jlc-compiler.js && node --check scripts/build-web.mjs && node --check scripts/serve-web.mjs && npm run check:web && node --test"
  },
  "keywords": [
    "jlc",
    "language",
    "bytecode",
    "virtual-machine",
    "reactive",
    "dom",
    "kernel"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
